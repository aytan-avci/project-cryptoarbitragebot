# Crypto Arbitrage Agent — environment TEMPLATE.
#
# ⚠️  THIS FILE IS A TEMPLATE. NEVER PUT REAL CREDENTIALS HERE.
#     This file is committed to the repo (visible to anyone). Real
#     credentials live in `.env` (gitignored, never leaves your machine).
#
# Setup:
#   1. cp .env.example .env
#   2. Edit .env  — put real API keys there (NOT here)
#   3. Verify: `git status` MUST NOT list .env
#
# If you ever paste a real key into this file by mistake, follow
# `specs/SECURITY.md § 5.1` (Suspected credential leak playbook).

# Execution mode: "paper" (default, safe) or "live" (real money — see CLAUDE.md § 2 C3).
EXECUTION_MODE=paper

# Exchange API credentials.
# CLAUDE.md § 2 C1: trade-only keys, IP-whitelisted, NO withdrawal permission.
# Leave blank for paper mode. Real values go in .env, not here.
BINANCE_API_KEY=
BINANCE_API_SECRET=

BYBIT_API_KEY=
BYBIT_API_SECRET=

# Structured-log level: DEBUG | INFO | WARNING | ERROR.
LOG_LEVEL=INFO

# Live exchanges (Faz 7a — opt-in; default False uses synthetic paper data).
# When enabled, pipeline fetches the real exchange public order book.
# No API key needed for read-only access (Faz 7b adds auth).
BINANCE_ENABLED=false
BINANCE_REST_BASE_URL=https://api.binance.com
BINANCE_RATE_LIMIT_PER_MIN=60

BYBIT_ENABLED=false
BYBIT_REST_BASE_URL=https://api.bybit.com
BYBIT_RATE_LIMIT_PER_MIN=120

# WebSocket ingestion (Faz 7c). `poll` keeps REST behaviour; `ws` switches
# to event-driven subscriptions via each adapter's subscribe(). `ws` mode
# runs for WS_TIMEOUT_S seconds then shuts down.
INGESTION_MODE=poll
WS_TIMEOUT_S=30

# SECURITY.md S4 — uncomment ONLY if you've reviewed
# specs/SECURITY.md § Per-Faz Gates and are intentionally trading on
# mainnet. Setting this to `true` for testnet has no effect.
# LIVE_TRADING_CONFIRMED=true
